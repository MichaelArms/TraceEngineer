<Window x:Class="TraceEngineer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trace Engineer - Telemetry Analyzer"
        Height="850" Width="1400"
        Background="#1B1B1C" Foreground="White">


    <Window.Resources>
        <Style x:Key="PlainListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter Margin="0,1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style x:Key="TabButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="#252528" BorderBrush="#3A3A3E"
                                BorderThickness="1" Padding="14,5" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3106"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFCD3C"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                                <Setter Property="Foreground" Value="#FFE28A"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#303038"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#6A6A70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Bottone neutro: sfondo scuro, bordo sottile, hover che schiarisce -->
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E8E8EE"/>
            <Setter Property="Background" Value="#2A2A2E"/> 
            <Setter Property="BorderBrush" Value="#3A3A3E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#34343A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4A4A52"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3E3E46"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#6A6A70"/>
                                <Setter TargetName="Bd" Property="Background" Value="#232326"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#303034"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Azione positiva (save): verde tenue -->
        <Style x:Key="ToolButtonSuccess" TargetType="Button">
            <Setter Property="Foreground" Value="#7FE0A0"/>
            <Setter Property="Background" Value="#0F3A1F"/>
            <Setter Property="BorderBrush" Value="#2E7A4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#154A28"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3AA065"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1B5A32"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#6A6A70"/>
                                <Setter TargetName="Bd" Property="Background" Value="#232326"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#303034"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>        

        <!-- Azione primaria: accento giallo, coerente col tab selezionato -->
        <Style x:Key="ToolButtonAccent" TargetType="Button">
            <Setter Property="Foreground" Value="#FFE28A"/>
            <Setter Property="Background" Value="#3A3106"/>
            <Setter Property="BorderBrush" Value="#8A7420"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4A3F0A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFCD3C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#57490C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#6A6A70"/>
                                <Setter TargetName="Bd" Property="Background" Value="#232326"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#303034"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Azione distruttiva: rosso tenue, mai urlato -->
        <Style x:Key="ToolButtonDanger" TargetType="Button">
            <Setter Property="Foreground" Value="#FF9A9A"/>
            <Setter Property="Background" Value="#3A2326"/>
            <Setter Property="BorderBrush" Value="#5A3338"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4A2A2E"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#8A4A50"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#553136"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#6A6A70"/>
                                <Setter TargetName="Bd" Property="Background" Value="#232326"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#303034"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- RepeatButton trasparente per il click-sul-track della scrollbar -->
        <Style x:Key="TrackRepeatButton" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ScrollViewer con colonna scrollbar a larghezza fissa (per scrollbar sottile) -->
        <Style TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ScrollContentPresenter Grid.Column="0" Grid.Row="0"
                                Margin="{TemplateBinding Padding}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                CanContentScroll="{TemplateBinding CanContentScroll}"/>

                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                Grid.Column="1" Grid.Row="0"
                                Orientation="Vertical"
                                Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                Value="{TemplateBinding VerticalOffset}"
                                Maximum="{TemplateBinding ScrollableHeight}"
                                ViewportSize="{TemplateBinding ViewportHeight}"
                                Width="6"/>

                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                Grid.Column="0" Grid.Row="1"
                                Orientation="Horizontal"
                                Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                Value="{TemplateBinding HorizontalOffset}"
                                Maximum="{TemplateBinding ScrollableWidth}"
                                ViewportSize="{TemplateBinding ViewportWidth}"
                                Height="6"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Scrollbar a scomparsa: sottile, invisibile finché non passi sulla lista -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Style="{StaticResource TrackRepeatButton}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="Opacity" Value="0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Thumb.Style>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Bd" Background="#5A5A64"
                                                        CornerRadius="2" Margin="1"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#7A7A86"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#8A8A96"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Style="{StaticResource TrackRepeatButton}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="4"/>
                    <Setter Property="Width" Value="auto"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Open .duckdb file" Style="{StaticResource ToolButton}"
                    Width="170" Height="36" Margin="0,0,8,0" Click="OpenDuckDb_Click"/>
            <Button Content="Export Session (CSV)" Style="{StaticResource ToolButton}"
                    Width="170" Height="36" Margin="0,0,8,0" Click="ExportCsv_Click"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="13" Foreground="#7FE07F" Margin="14,0,0,0"/>
        </StackPanel>

        <!-- Channel selectors -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <RadioButton x:Name="RbTabCar"    Content="Car"    GroupName="Tabs" IsChecked="True"
                                 Style="{StaticResource TabButton}" Click="Tab_Click"/>
                    <RadioButton x:Name="RbTabTyres"  Content="Tyres"  GroupName="Tabs"
                                 Style="{StaticResource TabButton}" Click="Tab_Click"/>
                    <RadioButton x:Name="RbTabBrakes" Content="Brakes" GroupName="Tabs"
                                 Style="{StaticResource TabButton}" Click="Tab_Click"/>
                    <RadioButton x:Name="RbTabStint" Content="Stint" GroupName="Tabs"
                                 Style="{StaticResource TabButton}" Click="Tab_Click"/>                                 

                    <TextBlock Text="    X axis:" VerticalAlignment="Center" Margin="10,0,8,0" Foreground="#808085"/>
                    <RadioButton x:Name="RbTime" Content="Time" GroupName="Axis"
                                 VerticalAlignment="Center" Margin="0,0,12,0" Foreground="White" Click="Axis_Click"/>
                    <RadioButton x:Name="RbDistance" Content="Distance" GroupName="Axis" IsChecked="True"
                                 VerticalAlignment="Center" Foreground="White" Click="Axis_Click"/>
                </StackPanel>

                <WrapPanel x:Name="OptionsPanel">
                    <TextBlock Text="Base:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#808085"/>
                    <CheckBox x:Name="ChkSpeed"    Content="Speed"    IsChecked="True"  VerticalAlignment="Center" Margin="0,0,14,0" Click="Channel_Click" Foreground="White"/>
                    <CheckBox x:Name="ChkThrottle" Content="Throttle" IsChecked="True"  VerticalAlignment="Center" Margin="0,0,14,0" Click="Channel_Click" Foreground="White"/>
                    <CheckBox x:Name="ChkBrake"    Content="Brake"    IsChecked="True"  VerticalAlignment="Center" Margin="0,0,14,0" Click="Channel_Click" Foreground="White"/>
                    <CheckBox x:Name="ChkSteering" Content="Steering" IsChecked="False" VerticalAlignment="Center" Margin="0,0,14,0" Click="Channel_Click" Foreground="White"/>
                    <CheckBox x:Name="ChkRpm"      Content="RPM"      IsChecked="False" VerticalAlignment="Center" Margin="0,0,14,0" Click="Channel_Click" Foreground="White"/>
                    <CheckBox x:Name="ChkHideShifts" Content="Hide shift cuts" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0" Click="Channel_Click" Foreground="White"/>

                    <TextBlock Text="   Hybrid:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#808085"/>
                    <CheckBox x:Name="ChkSoC"       Content="SoC"        IsChecked="False" VerticalAlignment="Center" Margin="0,0,14,0" Click="Channel_Click" Foreground="White"/>
                    <CheckBox x:Name="ChkErs"       Content="ERS power"  IsChecked="False" VerticalAlignment="Center" Margin="0,0,14,0" Click="Channel_Click" Foreground="White"/>
                </WrapPanel>
                <WrapPanel x:Name="StintOptionsPanel" Visibility="Collapsed">
                    <TextBlock Text="Stint metrics:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#808085"/>
                    <CheckBox x:Name="ChkStLapTime" Content="Lap time" IsChecked="True"
                              VerticalAlignment="Center" Margin="0,0,14,0" Click="StintExclude_Changed" Foreground="White"/>
                    <CheckBox x:Name="ChkStTyreTemp" Content="Tyre temp" IsChecked="False"
                              VerticalAlignment="Center" Margin="0,0,14,0" Click="StintExclude_Changed" Foreground="White"/>
                    <CheckBox x:Name="ChkStTyrePress" Content="Tyre pressure" IsChecked="False"
                              VerticalAlignment="Center" Margin="0,0,14,0" Click="StintExclude_Changed" Foreground="White"/>
                    <CheckBox x:Name="ChkStTyreWear" Content="Tyre wear" IsChecked="False"
                              VerticalAlignment="Center" Margin="0,0,14,0" Click="StintExclude_Changed" Foreground="White"/>
                    <CheckBox x:Name="ChkStSoC" Content="SoC" IsChecked="False"
                              VerticalAlignment="Center" Margin="0,0,14,0" Click="StintExclude_Changed" Foreground="White"/>
                    <CheckBox x:Name="ChkStBrakeTemp" Content="Brake temp" IsChecked="False"
                              VerticalAlignment="Center" Margin="0,0,14,0" Click="StintExclude_Changed" Foreground="White"/>
                    <CheckBox x:Name="ChkStBrakeWear" Content="Brake wear" IsChecked="False"
                              VerticalAlignment="Center" Margin="0,0,14,0" Click="StintExclude_Changed" Foreground="White"/>
                    <CheckBox x:Name="ChkStSpeed" Content="Speed" IsChecked="False"
                              VerticalAlignment="Center" Margin="0,0,14,0" Click="StintExclude_Changed" Foreground="White"/>

                    <TextBlock Text="   " VerticalAlignment="Center"/>
                    <CheckBox x:Name="ChkStintExclude" Content="Exclude anomalous" IsChecked="False"
                              VerticalAlignment="Center" Click="StintExclude_Changed" Foreground="White"/>
                </WrapPanel>              
            </StackPanel>

            <Border Grid.Column="1" x:Name="TrackMapBorder" Visibility="Collapsed"
                    Background="#212124" BorderBrush="#3A3A3E" BorderThickness="1"
                    CornerRadius="4" Width="170" Height="120"
                    VerticalAlignment="Top" Margin="8,0,0,0">
                <Canvas x:Name="TrackMapCanvas" ClipToBounds="True"/>
            </Border>
        </Grid>

        <!-- Session info -->
        <TextBlock Grid.Row="2" x:Name="SessionInfo" FontSize="13" Foreground="#B0B0B0" Margin="0,0,0,8"/>

        <!-- Main content: resizable split -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="240"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left panel -->
            <Border Grid.Column="0" Background="#252528" BorderBrush="#3A3A3E" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Session laps (max 2)" FontSize="13" FontWeight="SemiBold"
                            Foreground="White" Margin="8,8,8,2"/>

                    <TextBlock Grid.Row="1" x:Name="SessionHeader" FontSize="11" Foreground="#A0A0A5"
                            TextWrapping="Wrap" Margin="8,0,8,4"/>

                    <ListBox Grid.Row="2" x:Name="LapList"
                            SelectionMode="Single"
                            PreviewMouseLeftButtonDown="LapsList_PreviewMouseLeftButtonDown"
                            ItemContainerStyle="{StaticResource PlainListBoxItem}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            Background="#252528" Foreground="White" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Width="6" Fill="{Binding RowBg}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,3,4,3">
                                        <TextBlock Text="{Binding LapNumber, StringFormat='Lap {0}'}"
                                                FontWeight="SemiBold" Margin="0,0,8,0" Foreground="White"/>
                                        <TextBlock Text="{Binding LapTimeFormatted}" Foreground="#A0A0A5"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="3" x:Name="BtnSaveLap" Content="Save selected lap"
                            Style="{StaticResource ToolButtonSuccess}"
                            Height="34" Margin="8,6" Click="SaveLap_Click" IsEnabled="False"/>

                    <TextBlock Grid.Row="4" Text="Saved laps (library)" FontSize="13" FontWeight="SemiBold"
                            Foreground="White" Margin="8,10,8,4"/>

                    <ListBox Grid.Row="5" x:Name="SavedList"
                            SelectionMode="Single"
                            PreviewMouseLeftButtonDown="LapsList_PreviewMouseLeftButtonDown"
                            ItemContainerStyle="{StaticResource PlainListBoxItem}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            Background="#252528" Foreground="White" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Width="6" Fill="{Binding RowBg}"/>
                                    <StackPanel Grid.Column="1" Margin="6,3,4,3">
                                        <TextBlock Foreground="White" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding LapNumber, StringFormat='L{0}'}"/>
                                            <Run Text=" • "/>
                                            <Run Text="{Binding CarName}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="#C8C8CE"
                                                   Text="{Binding LapTimeFormatted}"/>
                                        <TextBlock FontSize="10" Foreground="#7A7A80"
                                                   TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding TrackName}"/>
                                            <Run Text="  •  "/>
                                            <Run Text="{Binding DisplayDate}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="6" x:Name="BtnDeleteSavedLap" Content="Delete selected lap"
                            Style="{StaticResource ToolButtonDanger}"
                            Height="34" Margin="8,6" Click="DeleteSavedLap_Click"/>

                    <TextBlock Grid.Row="7" x:Name="TrackRefText" FontSize="10" Foreground="#7FE07F"
                            TextWrapping="Wrap" Margin="8,6"/>
                </Grid>
            </Border>

            <!-- GridSplitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="#2A2A2E" ResizeBehavior="PreviousAndNext"/>

            <!-- Chart -->
            <Border Grid.Column="2" Background="#212124" BorderBrush="#3A3A3E" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Canvas Grid.Row="0" x:Name="ChartCanvas" Background="#1E1E20" ClipToBounds="True"
                        SizeChanged="ChartCanvas_SizeChanged"
                        MouseMove="ChartCanvas_MouseMove"
                        MouseLeave="ChartCanvas_MouseLeave"/>

                    <Ellipse Grid.Row="0" x:Name="HoverDot" Width="7" Height="7"
                            Fill="White" Stroke="Black" StrokeThickness="1"
                            Visibility="Collapsed" IsHitTestVisible="False"
                            HorizontalAlignment="Left" VerticalAlignment="Top"/>

                    <Border Grid.Row="0" x:Name="HoverTip" Visibility="Collapsed"
                            IsHitTestVisible="False" Background="#E61B1B1C"
                            BorderBrush="#3A3A3E" BorderThickness="1" Padding="6,4"
                            HorizontalAlignment="Left" VerticalAlignment="Top">
                        <TextBlock x:Name="HoverTipText" FontSize="11" Foreground="White"/>
                    </Border>

                    <Slider Grid.Row="1" x:Name="CursorSlider"
                            Minimum="0" Maximum="1000" Value="0"
                            Margin="69,0,7,8"
                            ValueChanged="CursorSlider_ValueChanged"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>