<Window x:Class="TraceEngineer.SaveLapDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save lap"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="#1B1B1C" Foreground="White">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Track" VerticalAlignment="Center" Margin="0,6"/>
        <TextBox  Grid.Row="0" Grid.Column="1" x:Name="TxtTrack" Margin="0,4" Height="26"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Car" VerticalAlignment="Center" Margin="0,6"/>
        <TextBox  Grid.Row="1" Grid.Column="1" x:Name="TxtCar" Margin="0,4" Height="26"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Class" VerticalAlignment="Center" Margin="0,6"/>
        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CmbClass" Margin="0,4" Height="26">
            <ComboBoxItem Content="Hypercar LMH" IsSelected="True"/>
            <ComboBoxItem Content="Hypercar LMDh"/>
            <ComboBoxItem Content="GT3"/>
            <ComboBoxItem Content="LMP2"/>
            <ComboBoxItem Content="LMP1"/>
            <ComboBoxItem Content="Other"/>
        </ComboBox>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Date" VerticalAlignment="Center" Margin="0,6"/>
        <TextBox  Grid.Row="3" Grid.Column="1" x:Name="TxtDate" Margin="0,4" Height="26"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Notes" VerticalAlignment="Center" Margin="0,6"/>
        <TextBox  Grid.Row="4" Grid.Column="1" x:Name="TxtNote" Margin="0,4" Height="50"
                  TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" x:Name="TxtLapInfo"
                   Margin="0,10,0,0" Foreground="#7FE07F"/>

        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Save" Width="100" Height="32" Margin="0,0,8,0" Click="Ok_Click"/>
            <Button Content="Cancel" Width="100" Height="32" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>